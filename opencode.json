{
  "$schema": "https://opencode.ai/config.json",
  "model": "opencode-go/gpt-5.6-luna",
  "small_model": "opencode-go/qwen3.8-flash",
  "agent": {
    "build": {
      "model": "opencode-go/gpt-5.6-luna"
    },
    "explore": {
      "model": "opencode-go/qwen3.8-flash"
    },
    "reviewer": {
      "model": "opencode-go/gpt-5.6-luna"
    }
  },
  "mcp": {
    "atlassian": {
      "type": "remote",
      "url": "https://mcp.atlassian.com/v1/mcp/authv2",
      "enabled": true,
      "oauth": {}
    }
  },
  "references": {
    "roadmap": {
      "path": "docs/roadmap.md",
      "description": "Use for the human-owned product roadmap; near-term items become backlog tickets"
    },
    "plans": {
      "path": "docs/plans",
      "description": "Use for past and current backlog batch plans"
    },
    "specs": {
      "path": "docs/superpowers/specs",
      "description": "Use for approved design specs (e.g. the backlog planner design)"
    }
  }
}
